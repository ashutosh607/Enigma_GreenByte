# Demo keys only work when this explicit opt-in is set. Never use with real companies.
PS5_DEMO=1
PS5_DATABASE=var/ps5.sqlite
PS5_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# For real integration: set PS5_DEMO=0 and provision opaque server-side keys.
# JSON maps bearer tokens to company IDs. Keep this on the server, never in browser source.
# PS5_TOKENS={"replace-with-long-random-company-token":"company-id"}
# PS5_ADMIN_TOKEN=replace-with-separate-long-random-admin-token

# Default is fast lexical/alias retrieval. Enable semantic retrieval after installing
# the embeddings extra and choosing a compatible, reviewed model or local model path.
PS5_EMBEDDINGS=lexical
PS5_EMBEDDING_MODEL=Alibaba-NLP/gte-large-en-v1.5

# Optional OpenAI-compatible extraction provider; no data is sent unless configured
# and an authenticated user explicitly submits text to /v1/extractions.
# PS5_LLM_BASE_URL=https://your-provider.example/v1
# PS5_LLM_MODEL=your-structured-extraction-model
# PS5_LLM_API_KEY=your-server-only-key
