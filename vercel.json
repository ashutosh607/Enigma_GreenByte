{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "ml",
          "format": "url",
          "env": "FASTAPI_ML_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/:page(marketplace|ai-discovery|dashboard|admin|register|signup)",
          "destination": "/index.html"
        },
        {
          "source": "/:section(materials|opportunities|deals)/:id",
          "destination": "/index.html"
        }
      ]
    },
    "ml": {
      "root": "ml",
      "framework": "fastapi",
      "entrypoint": "ps5.api:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
